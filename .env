# Environment variables for TaskHub Frontend

VITE_API_BASE_URL=http://localhost:15155
# Thay đổi từ https://localhost:17057 thành http://localhost:15155

# AWS Cognito Configuration (for future integration)
VITE_AWS_REGION=us-east-1
VITE_COGNITO_USER_POOL_ID=your-user-pool-id
VITE_COGNITO_CLIENT_ID=your-client-id
VITE_COGNITO_DOMAIN=your-cognito-domain

# App Configuration
VITE_APP_NAME=TaskHub
VITE_APP_VERSION=1.0.0

# Feature flags
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG=true